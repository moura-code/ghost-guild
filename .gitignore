# Godot generates import sidecars for the preview PNGs; they are throwaway
# scratch, not assets, and the game never loads from art_previews/.
art_previews/*.import
art_previews/comfyui.log
art_previews/raw/

# Stage 0 spike scratch. assets/_spike/ holds borrowed rigged models used only
# to prove the animation import path in tools/spike_crypt.gd; they are not
# game content, carry their own licences, and the directory goes away with the
# spike.
assets/_spike/
