; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Ghost Guild"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"
run/main_scene="res://game/main.tscn"

[autoload]

Game="*res://game/game.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

; Pixel art. The game renders at 640x360 and the whole viewport is scaled up
; by an integer factor -- x2 into a 1280x720 window -- so every pixel stays
; square and sharp. "viewport" rather than "canvas_items" is the point: with
; canvas_items Godot would render text and vectors at native resolution and
; the pixels would only be in the textures, which reads as pixel art pasted
; onto a smooth UI. Everything has to live on the same grid.
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[rendering]

; No filtering anywhere: a bilinear-sampled sprite is a blurry sprite, and
; one blurry element is enough to break the illusion for the whole screen.
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
